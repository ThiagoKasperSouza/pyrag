# ===== LLM / Embeddings =====
# Escolha o provedor: "ollama" | "groq" | "gemini" | "openrouter" | "auto" | "none"
PYRAG_LLM_PROVIDER=ollama

# --- Ollama (100% local e gratuito) ---
OLLAMA_BASE_URL=http://localhost:11434
PYRAG_CHAT_MODEL=qwen2.5:0.5b
PYRAG_REASONING_MODEL=qwen2.5:0.5b
PYRAG_EMBED_MODEL=embeddinggemma:300m

# Modelos recomendados (rode `ollama pull <modelo>` antes):
#   chat      : llama3.1:8b  |  qwen2.5:7b  |  mistral-nemo
#   raciocinio: qwen2.5:7b   |  deepseek-r1:7b
#   embeddings: embeddinggemma:300m  |  nomic-embed-text
#   embeddings: bge-m3 (multilingue, bom para PT-BR)

# --- Groq (free tier, requires GROQ_API_KEY) ---
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_REASONING_MODEL=deepseek-r1-distill-llama-70b

# --- Google AI Studio Gemini (free tier) ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_REASONING_MODEL=gemini-2.0-flash-thinking-exp-1219

# --- OpenRouter (modelos :free) ---
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_REASONING_MODEL=deepseek/deepseek-r1-70b:free

# ==================== RAG ====================
PYRAG_CHUNK_SIZE=1000
PYRAG_CHUNK_OVERLAP=180
PYRAG_TOP_K=6
PYRAG_TOP_K_RERANK=20
PYRAG_RERANK=heuristic
PYRAG_SIMILARITY_THRESHOLD=0.0
PYRAG_TEMPERATURE=0.1
PYRAG_MAX_TOKENS=1200
PYRAG_HISTORY_TURNS=6

# ================== Armazenamento ==================
PYRAG_DATA_DIR=./data
PYRAG_CHROMA_DIR=./data/chroma
PYRAG_CACHE_DIR=./data/cache

# ==================== Tools ====================
PYRAG_ENABLE_WEB_SEARCH=true
PYRAG_ENABLE_SQL=true
PYRAG_ENABLE_CALC=true
PYRAG_SQL_DB_PATH=./data/pyrag.db
PYRAG_SQL_ALLOW_WRITE=false
PYRAG_AGENT_MAX_ITERATIONS=8

# ================= A2A (Agent2Agent) =================
PYRAG_A2A_ENABLED=true
PYRAG_A2A_BIND_HOST=0.0.0.0
PYRAG_A2A_BIND_PORT=9100
PYRAG_A2A_PUBLIC_URL=http://localhost:9100
PYRAG_AGENT_NAME=pyrag-orchestrator
PYRAG_AGENT_DESCRIPTION=Agente RAG com ferramentas que delega tarefas a agentes remotos via A2A.
PYRAG_AGENT_VERSION=0.1.0
PYRAG_A2A_PEERS_FILE=./data/peers.json
PYRAG_A2A_API_KEY=
PYRAG_A2A_TIMEOUT=180

# ================= Servidor HTTP =================
PYRAG_API_HOST=0.0.0.0
PYRAG_API_PORT=8000
PYRAG_LOG_LEVEL=INFO
